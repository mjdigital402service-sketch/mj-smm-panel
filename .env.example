# ---------- Core ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smm_panel?schema=public"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Random 32+ byte secret. Generate: openssl rand -base64 32
AUTH_SECRET="replace-me"

# AES-256-GCM key for provider secrets at rest (must decode to 32 bytes).
# Generate: openssl rand -base64 32
ENCRYPTION_KEY="replace-me"

# Shared secret protecting POST /api/internal/sync-orders (cron trigger).
CRON_SECRET="replace-me"

# ---------- Payments ----------
# Manual/UPI/bank flows need no keys. For a gateway, add verified-webhook settings here.
PAYMENT_GATEWAY="none"
PAYMENT_WEBHOOK_SECRET=""

# ---------- File storage ----------
# local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------- Providers ----------
# Provider URLs/keys are entered in Admin > Providers and stored encrypted in the DB.
# Nothing provider-specific belongs in this file.
